  "layer": "LIVE",
  "img": "V7_4_6_arrives.jpg",
  "mode": "CAM",
  "who": "MANAN",
  "text": "So the limit isn't my body. It's your judgement. They call it the Central Governor Theory.",
  "fr": 178,
  "in": 1491,
  "out": 1669,
  "trans": "ON SCREEN SUBTITLE, small, low in frame, held two seconds, nobody speaks it:\n\"Central Governor Theory, proposed by Prof. Tim Noakes, 1997. An influential model. Scientists are still investigating how the brain and muscles produce fatigue.\"\nIt costs no running time because it is not spoken, and it is what protects the film on scientific accuracy.",
  "measured": false,
  "old_id": "4.7"
 },
 {
  "scene": 4,
  "id": "4.9",
  "layer": "LIVE",
  "img": "V7_4_8_definition.jpg",
  "mode": "CAM",
  "who": "MANAN",
  "text": "It sets your limit in advance, and keeps something in reserve.",
  "fr": 140,
  "in": 1669,
  "out": 1809,
  "trans": "TO SHOOT 18 AUG. Direct continuation of 4.7, identical setup, identical light, cut on the same breath so the two panels read as one take. This is the only sentence in the film that states the science plainly, so he says it slowly and to camera. Noakes and 1997 stay on the lower third underneath.",
  "measured": false,
  "old_id": "4.8"
 },
