  "mode": "VO",
  "who": "MANAN",
  "text": "A. V. Hill. Nineteen twenty three.",
  "fr": 70,
  "in": 255,
  "out": 325,
  "trans": "THE BOARD IS SHOT COMPLETELY EMPTY except for one vertical chalk line down the middle. Everything else is composited afterwards. Manan must actually write on it on the day, so the chalk in his hand moves and his arm passes in front of the writing. The left half carries a quick chalk sketch of A. V. Hill and his year. The right half carries 1997, T. Noakes, and the new chain.",
  "measured": false,
  "old_id": "2.1"
 },
